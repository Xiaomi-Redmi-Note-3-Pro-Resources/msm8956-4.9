# Xiaomi Redmi Note 3 (kenzo/kate), on top of vendor/msm8976-perf_defconfig
CONFIG_MACH_XIAOMI_KENZO=y

# The bootloader picks one of the appended device trees by board and SoC id
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="qcom/msm8956-kenzo-mtp qcom/msm8956-v1.1-kenzo-mtp"

# Touch: FocalTech or Atmel, never writing to the controller
CONFIG_TOUCHSCREEN_FT5X06=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_TOUCHSCREEN_XIAOMI_NO_FW_UPDATE=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_v26 is not set

# Crash logs at the same place as the stock kernel
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_CMDLINE="ramoops_memreserve=4M"
CONFIG_CMDLINE_EXTEND=y

# The stock bootloader ignores the boot image addresses: it puts the device tree
# at 0x81e00000 and the ramdisk at 0x82000000, so the kernel (with its bss) must
# end below 0x81e00000. It passes no kaslr-seed, so KASLR's relocation data
# would only take up that space.
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_DEBUG_ALIGN_RODATA is not set

# Retail phones block the CoreSight debug registers: probing them is a bus
# error that kills init. The stock kernel checks a fuse before using them.
# CONFIG_CORESIGHT is not set
